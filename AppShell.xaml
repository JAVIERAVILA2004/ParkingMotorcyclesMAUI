<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ParkingMotorcycles.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ParkingMotorcycles"
    Shell.FlyoutBehavior="Flyout"
    Title="ParkingMotorcycles"
    BackgroundColor="Gray"
    Shell.TitleColor="Black">
    

    <ShellContent
        Title="ParkingMotorcycles"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage"
        Shell.FlyoutBehavior="Disabled"/>

    <Shell.ToolbarItems>
        <ToolbarItem IconImageSource="pencil.svg" Clicked="ToolbarItem_Clicked_1"/>
        <ToolbarItem IconImageSource="config_icons.svg" Clicked="ToolbarItem_Clicked"/>
    </Shell.ToolbarItems>



</Shell>
