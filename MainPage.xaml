<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ParkingMotorcycles.MainPage"
             Background="#D3D3D3">

    <ScrollView>
        <VerticalStackLayout Padding="30,50" Spacing="20">

            <!-- Imagen del logo -->
            <Image
            Source="parking.png"
            HeightRequest="200"
            Aspect="AspectFit"
            HorizontalOptions="Center" />

            <!-- Slogan -->
            <Label 
            Text="Tu moto, tu espacio. Estaciona con confianza."
            FontFamily="AntiHeroFont"
            FontSize="24"
            HorizontalTextAlignment="Center"
            VerticalTextAlignment="Center"
            Padding="10,0"
            TextColor="Black" />

            <!-- Botón centrado -->
            <Button
            x:Name="btnIniciar"
            Text="Iniciar"
            Clicked="btnIniciar_Clicked"
            HorizontalOptions="Fill"
            HeightRequest="50"
            CornerRadius="10"
            BackgroundColor="#007AFF"
            TextColor="White"
            FontSize="18" />

        </VerticalStackLayout>
    </ScrollView>



</ContentPage>
