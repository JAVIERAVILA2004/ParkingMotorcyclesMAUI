<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ParkingMotorcycles.Config"
             Title="Config">
    <VerticalStackLayout Padding="20" Spacing="20">
        <Label Text="Configuración de Tarifas" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center"/>

        <Label Text="Precio por Minuto ($):" FontSize="18"/>
        <Entry x:Name="PrecioMinuto" Keyboard="Numeric" Placeholder="Ingrese el precio por minuto"/>

        <Label Text="Precio por Hora ($):" FontSize="18"/>
        <Entry x:Name="PrecioHora" Keyboard="Numeric" Placeholder="Ingrese el precio por hora"/>

        <Button Text="Guardar Configuración" Clicked="GuardarConfiguracion" BackgroundColor="#6750A4" TextColor="White"/>

        <Button Text="Volver" Clicked="Volver" BackgroundColor="Gray" TextColor="White"/>
    </VerticalStackLayout>
</ContentPage>